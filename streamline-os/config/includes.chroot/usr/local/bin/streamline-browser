#!/bin/sh
set -eu

LAUNCHER="file:///usr/share/streamline/launcher.html"

if command -v firefox-esr >/dev/null 2>&1; then
  exec firefox-esr --kiosk --new-window "$LAUNCHER"
fi

if command -v firefox >/dev/null 2>&1; then
  exec firefox --kiosk --new-window "$LAUNCHER"
fi

if command -v xdg-open >/dev/null 2>&1; then
  exec xdg-open "$LAUNCHER"
fi

echo "No supported browser is installed." >&2
exit 1
