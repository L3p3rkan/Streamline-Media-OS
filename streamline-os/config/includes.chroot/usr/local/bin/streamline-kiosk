#!/usr/bin/python3
"""Serve the local dashboard and supervise its dedicated Firefox profile."""

from __future__ import annotations

import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import unquote, urlsplit


REMOTE_LIB = Path("/usr/local/lib/streamline")
if REMOTE_LIB.is_dir():
    sys.path.insert(0, str(REMOTE_LIB))
try:
    from streamline_remote import RemoteControl, RemoteControlError, create_remote_server
except ImportError as import_error:
    RemoteControl = None
    RemoteControlError = RuntimeError
    create_remote_server = None
    print(f"streamline-kiosk: remote-control support is unavailable: {import_error}")


HOST = "127.0.0.1"
PORT = 8765
REMOTE_PORT = 8766
APP_ROOT = Path("/usr/share/streamline/web")
LEGACY_PROFILE_ROOT = Path.home() / ".local" / "share" / "streamline" / "firefox-profile"
SNAP_PROFILE_ROOT = Path.home() / "snap" / "firefox" / "common" / "streamline-profile"
PROFILE_ROOT = (
    SNAP_PROFILE_ROOT
    if Path("/snap/firefox/current").exists()
    else LEGACY_PROFILE_ROOT
)
ALLOWED_ORIGIN = f"http://{HOST}:{PORT}"
BOOT_ID_PATH = Path("/proc/sys/kernel/random/boot_id")
EXIT_MARKER_DIRECTORY = (
    Path("/run/lock") if Path("/run/lock").is_dir() else Path("/tmp")
)


def _profile_roots() -> tuple[Path, ...]:
    return tuple(dict.fromkeys((PROFILE_ROOT, LEGACY_PROFILE_ROOT, SNAP_PROFILE_ROOT)))


def _migrate_profile(legacy_root: Path, active_root: Path) -> None:
    if legacy_root == active_root or not legacy_root.is_dir() or active_root.exists():
        return
    active_root.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(
        legacy_root,
        active_root,
        ignore=shutil.ignore_patterns("lock", "parent.lock"),
    )


def _configure_firefox_home(profile_root: Path) -> None:
    user_js = profile_root / "user.js"
    existing_lines = user_js.read_text(encoding="utf-8").splitlines() if user_js.exists() else []
    managed_preferences = {
        'browser.startup.homepage': (
            f'user_pref("browser.startup.homepage", {json.dumps(ALLOWED_ORIGIN + "/")});'
        ),
        'browser.startup.page': 'user_pref("browser.startup.page", 1);',
        'browser.backspace_action': 'user_pref("browser.backspace_action", 0);',
        'media.eme.enabled': 'user_pref("media.eme.enabled", true);',
    }
    preserved_lines = [
        line
        for line in existing_lines
        if not any(line.lstrip().startswith(f'user_pref("{name}",') for name in managed_preferences)
    ]
    user_js.write_text(
        "\n".join([*preserved_lines, *managed_preferences.values()]) + "\n",
        encoding="utf-8",
    )


def _exit_marker_path(
    marker_directory: Path = EXIT_MARKER_DIRECTORY,
    boot_id_path: Path = BOOT_ID_PATH,
) -> Path:
    try:
        boot_id = boot_id_path.read_text(encoding="utf-8").strip()
    except OSError as error:
        raise RuntimeError(f"Could not read the current boot ID: {error}") from error
    if not boot_id:
        raise RuntimeError("The current boot ID is empty.")
    return marker_directory / f"streamline-exit-{boot_id}"


def _exit_requested_until_reboot(
    marker_directory: Path = EXIT_MARKER_DIRECTORY,
    boot_id_path: Path = BOOT_ID_PATH,
) -> bool:
    marker = _exit_marker_path(marker_directory, boot_id_path)
    return marker.is_file() and not marker.is_symlink()


def _mark_exit_until_reboot(
    marker_directory: Path = EXIT_MARKER_DIRECTORY,
    boot_id_path: Path = BOOT_ID_PATH,
) -> None:
    marker = _exit_marker_path(marker_directory, boot_id_path)
    marker_directory.mkdir(parents=True, exist_ok=True)
    try:
        descriptor = os.open(
            marker,
            os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0),
            0o644,
        )
    except FileExistsError:
        if marker.is_file() and not marker.is_symlink():
            return
        raise RuntimeError("An invalid exit marker already exists.")
    try:
        os.fchmod(descriptor, 0o644)
    finally:
        os.close(descriptor)


def _wifi_settings_command() -> list[str] | None:
    for executable, arguments in (
        ("gnome-control-center", ["wifi"]),
        ("nm-connection-editor", []),
    ):
        resolved = shutil.which(executable)
        if resolved:
            return [resolved, *arguments]
    return None


def _open_wifi_settings() -> None:
    command = _wifi_settings_command()
    if command is None:
        raise RuntimeError(
            "No Wi-Fi settings app was found. Install GNOME Control Center or NetworkManager's connection editor."
        )
    subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )


def _cleanup_temporary_browser(profile_directory: Path, process) -> None:
    try:
        process.wait()
    finally:
        shutil.rmtree(profile_directory, ignore_errors=True)


def _open_peacock_test() -> str:
    executable = shutil.which("google-chrome-stable") or shutil.which("google-chrome")
    if executable is None:
        raise RuntimeError(
            "Google Chrome is not installed. Install its official Linux package from https://www.google.com/chrome/, then try again."
        )

    runtime_directory = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
    if not runtime_directory.is_dir() or not os.access(runtime_directory, os.W_OK):
        runtime_directory = Path(tempfile.gettempdir())
    profile_directory = Path(
        tempfile.mkdtemp(prefix="streamline-peacock-test-", dir=runtime_directory)
    )
    command = [
        executable,
        f"--user-data-dir={profile_directory}",
        "--incognito",
        "--no-first-run",
        "--disable-background-mode",
        "--disable-sync",
        "--new-window",
        "https://www.peacocktv.com/",
    ]
    try:
        process = subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
    except OSError as error:
        shutil.rmtree(profile_directory, ignore_errors=True)
        raise RuntimeError(f"Could not open the temporary Chrome test window: {error}") from error

    cleanup = threading.Thread(
        target=_cleanup_temporary_browser,
        args=(profile_directory, process),
        name="streamline-peacock-test-cleanup",
        daemon=True,
    )
    cleanup.start()
    return "A temporary private Chrome window opened. Sign in to test Peacock; closing the window erases its temporary data."


class KioskRuntime:
    def __init__(self) -> None:
        self.clear_profile = threading.Event()
        self.stop = threading.Event()
        self.exit_requested = threading.Event()
        self.state_lock = threading.Lock()
        self.clear_error: str | None = None
        self.power_action: str | None = None
        self.power_error: str | None = None
        self.next_path = "/"
        self.browser: threading.Thread | None = None
        self.browser_process = None
        self.shutdown_callback = None

    def exit_streamline(self) -> None:
        self.stop.set()
        if self.shutdown_callback is not None:
            self.shutdown_callback()

    def execute_power_action(self, action: str) -> None:
        try:
            subprocess.run(
                ["systemctl", action],
                check=True,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                text=True,
                timeout=10,
            )
        except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as error:
            detail = getattr(error, "stderr", None) or str(error)
            if isinstance(detail, bytes):
                detail = detail.decode("utf-8", errors="replace")
            with self.state_lock:
                self.power_action = None
                self.power_error = detail.strip()[:400]
            print(f"streamline-kiosk: systemctl {action} failed: {detail}")
            return

        expiry = threading.Timer(15, self.expire_power_action, args=(action,))
        expiry.daemon = True
        expiry.start()

    def expire_power_action(self, action: str) -> None:
        with self.state_lock:
            if self.power_action == action:
                self.power_action = None
                self.power_error = (
                    f"systemctl {action} returned, but the computer stayed on. "
                    "Check local power permissions or shutdown blockers."
                )

    def supervise_browser(self) -> None:
        PROFILE_ROOT.parent.mkdir(parents=True, exist_ok=True)
        while not self.stop.is_set():
            if self.clear_profile.is_set():
                self._terminate_browser()
                try:
                    for profile_root in _profile_roots():
                        if profile_root.exists():
                            shutil.rmtree(profile_root)
                except OSError as error:
                    with self.state_lock:
                        self.clear_error = str(error)
                        self.next_path = "/settings?clearFailed=1"
                    print(f"streamline-kiosk: could not clear Firefox profile: {error}")
                else:
                    with self.state_lock:
                        self.clear_error = None
                        self.next_path = "/settings?loginDataCleared=1"
                self.clear_profile.clear()
                continue

            firefox = shutil.which("firefox-esr") or shutil.which("firefox")
            if not firefox:
                print("streamline-kiosk: Firefox is not installed; retrying in 5 seconds")
                time.sleep(5)
                continue

            PROFILE_ROOT.mkdir(parents=True, exist_ok=True)
            _configure_firefox_home(PROFILE_ROOT)
            command = [
                firefox,
                "--no-remote",
                "--profile",
                str(PROFILE_ROOT),
                "--kiosk",
                ALLOWED_ORIGIN + self.next_path,
            ]
            with self.state_lock:
                self.next_path = "/"
            self.browser_process = subprocess.Popen(
                command,
                start_new_session=True,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=None,
            )

            while (
                self.browser_process.poll() is None
                and not self.stop.is_set()
                and not self.clear_profile.wait(timeout=0.2)
            ):
                pass

            if self.stop.is_set():
                self._terminate_browser()
                return

            if not self.clear_profile.is_set():
                self.browser_process = None
                time.sleep(1)

    def _terminate_browser(self) -> None:
        process = self.browser_process
        if process is None:
            return
        try:
            os.killpg(process.pid, signal.SIGTERM)
            process.wait(timeout=8)
        except ProcessLookupError:
            return
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                print("streamline-kiosk: Firefox did not exit after SIGKILL")


runtime = KioskRuntime()
remote_control = RemoteControl() if RemoteControl is not None else None


class DashboardHandler(BaseHTTPRequestHandler):
    server_version = "StreamlineKiosk/1.0"

    def log_message(self, format: str, *args: object) -> None:
        print(f"streamline-kiosk: {format % args}")

    def _send_json(self, status: int, payload: dict[str, object]) -> None:
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        path = urlsplit(self.path).path
        if path == "/api/kiosk-status":
            self._send_json(
                200,
                {
                    "helperAvailable": True,
                    "profileExists": PROFILE_ROOT.exists(),
                    "clearInProgress": runtime.clear_profile.is_set(),
                    "clearError": runtime.clear_error,
                    "powerAction": runtime.power_action,
                    "powerError": runtime.power_error,
                    "wifiSettingsAvailable": _wifi_settings_command() is not None,
                    "remoteControlAvailable": remote_control is not None and remote_control.server_error is None,
                    "remoteInputReady": remote_control is not None and remote_control.input_ready(),
                },
            )
            return

        if path == "/api/remote-control":
            if self.headers.get("Host") != f"{HOST}:{PORT}":
                self._send_json(403, {"error": "Remote pairing details are available only on the local kiosk."})
            elif remote_control is None:
                self._send_json(503, {"error": "Remote-control support is unavailable. Reinstall the Streamline update."})
            else:
                self._send_json(200, remote_control.pairing_info())
            return

        if path.startswith("/api/"):
            self._send_json(404, {"error": "Not found"})
            return

        relative = unquote(path.lstrip("/"))
        requested = (APP_ROOT / relative).resolve()
        try:
            requested.relative_to(APP_ROOT.resolve())
        except ValueError:
            self._send_json(404, {"error": "Not found"})
            return

        if requested.is_dir():
            requested = requested / "index.html"
        if not requested.is_file():
            requested = APP_ROOT / "index.html"
        if not requested.is_file():
            self._send_json(503, {"error": "Dashboard files are missing"})
            return

        content_type = "text/html; charset=utf-8"
        suffix_types = {
            ".css": "text/css; charset=utf-8",
            ".js": "text/javascript; charset=utf-8",
            ".json": "application/json; charset=utf-8",
            ".svg": "image/svg+xml",
            ".png": "image/png",
            ".webp": "image/webp",
            ".ico": "image/x-icon",
            ".woff": "font/woff",
            ".woff2": "font/woff2",
        }
        content_type = suffix_types.get(requested.suffix, content_type)
        body = requested.read_bytes()
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header(
            "Content-Security-Policy",
            "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; "
            "font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; "
            "object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https:",
        )
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Cache-Control", "no-cache" if requested.name == "index.html" else "public, max-age=31536000, immutable")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:
        path = urlsplit(self.path).path
        if path not in {
            "/api/clear-login",
            "/api/power-action",
            "/api/exit-application",
            "/api/open-peacock-test",
            "/api/open-wifi-settings",
            "/api/remote-pairing/new",
            "/api/remote-pairing/revoke",
        }:
            self._send_json(404, {"error": "Not found"})
            return
        payload = self._read_local_json()
        if payload is None:
            return

        if path == "/api/remote-pairing/new":
            if payload != {}:
                self._send_json(400, {"error": "Expected an empty JSON object"})
                return
            if remote_control is None:
                self._send_json(503, {"error": "Remote-control support is unavailable."})
                return
            self._send_json(200, remote_control.refresh_pairing_code())
            return

        if path == "/api/remote-pairing/revoke":
            if set(payload) != {"deviceId"}:
                self._send_json(400, {"error": "A paired device ID is required."})
                return
            if remote_control is None:
                self._send_json(503, {"error": "Remote-control support is unavailable."})
                return
            try:
                revoked = remote_control.revoke_device(payload.get("deviceId"))
            except RemoteControlError as error:
                self._send_json(400, {"error": str(error)})
                return
            if not revoked:
                self._send_json(404, {"error": "That phone is no longer paired."})
                return
            self._send_json(200, {"accepted": True})
            return

        if path == "/api/power-action":
            action = payload.get("action")
            if set(payload) != {"action"} or not isinstance(action, str) or action not in {"poweroff", "reboot"}:
                self._send_json(400, {"error": "Action must be poweroff or reboot"})
                return
            with runtime.state_lock:
                if runtime.clear_profile.is_set():
                    self._send_json(409, {"error": "Login data is being cleared; try again when it finishes"})
                    return
                if runtime.power_action is not None:
                    self._send_json(409, {"error": "A power action is already in progress"})
                    return
                runtime.power_action = action
                runtime.power_error = None
            self._send_json(
                202,
                {
                    "accepted": True,
                    "action": action,
                    "message": "The power action was accepted.",
                },
            )
            timer = threading.Timer(0.75, runtime.execute_power_action, args=(action,))
            timer.daemon = True
            timer.start()
            return

        if path == "/api/open-wifi-settings":
            if payload != {}:
                self._send_json(400, {"error": "Expected an empty JSON object"})
                return
            with runtime.state_lock:
                if runtime.power_action is not None or runtime.clear_profile.is_set():
                    self._send_json(409, {"error": "Kiosk maintenance is in progress; try again when it finishes"})
                    return
            try:
                _open_wifi_settings()
            except (OSError, RuntimeError) as error:
                self._send_json(503, {"error": str(error)})
                return
            self._send_json(
                202,
                {
                    "accepted": True,
                    "message": "The system Wi-Fi settings were opened.",
                },
            )
            return

        if path == "/api/open-peacock-test":
            if payload != {}:
                self._send_json(400, {"error": "Expected an empty JSON object"})
                return
            with runtime.state_lock:
                if runtime.power_action is not None or runtime.clear_profile.is_set() or runtime.exit_requested.is_set():
                    self._send_json(409, {"error": "Kiosk maintenance is in progress; try again when it finishes"})
                    return
            try:
                message = _open_peacock_test()
            except (OSError, RuntimeError) as error:
                self._send_json(503, {"error": str(error)})
                return
            self._send_json(202, {"accepted": True, "message": message})
            return

        if path == "/api/exit-application":
            if payload != {}:
                self._send_json(400, {"error": "Expected an empty JSON object"})
                return
            with runtime.state_lock:
                if runtime.power_action is not None or runtime.clear_profile.is_set():
                    self._send_json(409, {"error": "Kiosk maintenance is in progress; try again when it finishes"})
                    return
                if runtime.exit_requested.is_set():
                    self._send_json(409, {"error": "Streamline is already exiting"})
                    return
                try:
                    _mark_exit_until_reboot()
                except (OSError, RuntimeError) as error:
                    self._send_json(503, {"error": f"Could not save the exit-until-restart state: {error}"})
                    return
                runtime.exit_requested.set()
            self._send_json(
                202,
                {
                    "accepted": True,
                    "message": "Streamline will close and stay exited until the computer restarts.",
                },
            )
            timer = threading.Timer(0.75, runtime.exit_streamline)
            timer.daemon = True
            timer.start()
            return

        if payload != {}:
            self._send_json(400, {"error": "Expected an empty JSON object"})
            return

        with runtime.state_lock:
            if runtime.power_action is not None:
                self._send_json(409, {"error": "A power action is already in progress"})
                return
            if runtime.clear_profile.is_set():
                self._send_json(409, {"error": "A profile clear is already in progress"})
                return
            runtime.clear_error = None
            runtime.clear_profile.set()
        self._send_json(
            202,
            {
                "accepted": True,
                "message": "Firefox is restarting with a clean profile.",
            },
        )

    def _read_local_json(self) -> dict[str, object] | None:
        if self.headers.get("Host") != f"{HOST}:{PORT}":
            self._send_json(403, {"error": "Unexpected host"})
            return None
        if self.headers.get("Origin") != ALLOWED_ORIGIN:
            self._send_json(403, {"error": "Request must come from the Streamline dashboard"})
            return None
        if self.headers.get_content_type() != "application/json":
            self._send_json(415, {"error": "Expected JSON"})
            return None
        try:
            length = int(self.headers.get("Content-Length", "0"))
            if length < 2:
                self._send_json(400, {"error": "Expected an empty JSON object"})
                return None
            if length > 4096:
                self._send_json(413, {"error": "Request too large"})
                return None
            payload = json.loads(self.rfile.read(length))
        except (ValueError, json.JSONDecodeError):
            self._send_json(400, {"error": "Invalid request"})
            return None
        if not isinstance(payload, dict):
            self._send_json(400, {"error": "Expected a JSON object"})
            return None
        return payload


def main() -> None:
    try:
        if _exit_requested_until_reboot():
            print("streamline-kiosk: exited by user; it will start again after the next reboot")
            return
    except RuntimeError as error:
        print(f"streamline-kiosk: cannot check exit-until-reboot state: {error}", file=sys.stderr)
        return

    _migrate_profile(LEGACY_PROFILE_ROOT, PROFILE_ROOT)
    PROFILE_ROOT.mkdir(parents=True, exist_ok=True)
    server = ThreadingHTTPServer((HOST, PORT), DashboardHandler)
    server.daemon_threads = True
    runtime.shutdown_callback = server.shutdown
    remote_server = None
    remote_server_thread = None
    if remote_control is not None and create_remote_server is not None:
        try:
            remote_server = create_remote_server(remote_control)
        except OSError as error:
            remote_control.server_error = f"Could not start the local remote-control service: {error}"
            print(f"streamline-kiosk: {remote_control.server_error}")
        else:
            remote_server_thread = threading.Thread(
                target=remote_server.serve_forever,
                kwargs={"poll_interval": 0.25},
                name="streamline-remote-control",
                daemon=True,
            )
            remote_server_thread.start()
    runtime.browser = threading.Thread(
        target=runtime.supervise_browser,
        name="streamline-firefox",
        daemon=True,
    )
    runtime.browser.start()
    try:
        server.serve_forever(poll_interval=0.25)
    except KeyboardInterrupt:
        pass
    finally:
        runtime.stop.set()
        runtime.clear_profile.set()
        server.shutdown()
        if remote_server is not None:
            remote_server.shutdown()
            remote_server.server_close()
        if remote_server_thread is not None:
            remote_server_thread.join(timeout=3)
        if remote_control is not None:
            remote_control.close()
        if runtime.browser is not None:
            runtime.browser.join(timeout=10)
        server.server_close()


if __name__ == "__main__":
    main()
