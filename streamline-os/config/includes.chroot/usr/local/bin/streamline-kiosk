#!/usr/bin/python3
"""Serve the local dashboard and supervise its dedicated Firefox profile."""

from __future__ import annotations

import json
import os
import shutil
import signal
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import unquote, urlsplit


HOST = "127.0.0.1"
PORT = 8765
APP_ROOT = Path("/usr/share/streamline/web")
PROFILE_ROOT = Path.home() / ".local" / "share" / "streamline" / "firefox-profile"
ALLOWED_ORIGIN = f"http://{HOST}:{PORT}"


class KioskRuntime:
    def __init__(self) -> None:
        self.clear_profile = threading.Event()
        self.stop = threading.Event()
        self.state_lock = threading.Lock()
        self.clear_error: str | None = None
        self.next_path = "/"
        self.browser: threading.Thread | None = None
        self.browser_process = None

    def supervise_browser(self) -> None:
        PROFILE_ROOT.parent.mkdir(parents=True, exist_ok=True)
        while not self.stop.is_set():
            if self.clear_profile.is_set():
                self._terminate_browser()
                try:
                    if PROFILE_ROOT.exists():
                        shutil.rmtree(PROFILE_ROOT)
                except OSError as error:
                    with self.state_lock:
                        self.clear_error = str(error)
                        self.next_path = "/settings?clearFailed=1"
                    print(f"streamline-kiosk: could not clear Firefox profile: {error}")
                else:
                    with self.state_lock:
                        self.clear_error = None
                        self.next_path = "/settings?loginDataCleared=1"
                self.clear_profile.clear()
                continue

            PROFILE_ROOT.mkdir(parents=True, exist_ok=True)
            command = [
                "firefox-esr",
                "--no-remote",
                "--profile",
                str(PROFILE_ROOT),
                "--kiosk",
                ALLOWED_ORIGIN + self.next_path,
            ]
            with self.state_lock:
                self.next_path = "/"
            self.browser_process = subprocess.Popen(
                command,
                start_new_session=True,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=None,
            )

            while (
                self.browser_process.poll() is None
                and not self.stop.is_set()
                and not self.clear_profile.wait(timeout=0.2)
            ):
                pass

            if self.stop.is_set():
                self._terminate_browser()
                return

            if not self.clear_profile.is_set():
                self.browser_process = None
                time.sleep(1)

    def _terminate_browser(self) -> None:
        process = self.browser_process
        if process is None:
            return
        try:
            os.killpg(process.pid, signal.SIGTERM)
            process.wait(timeout=8)
        except ProcessLookupError:
            return
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                print("streamline-kiosk: Firefox did not exit after SIGKILL")


runtime = KioskRuntime()


class DashboardHandler(BaseHTTPRequestHandler):
    server_version = "StreamlineKiosk/1.0"

    def log_message(self, format: str, *args: object) -> None:
        print(f"streamline-kiosk: {format % args}")

    def _send_json(self, status: int, payload: dict[str, object]) -> None:
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        path = urlsplit(self.path).path
        if path == "/api/kiosk-status":
            self._send_json(
                200,
                {
                    "helperAvailable": True,
                    "profileExists": PROFILE_ROOT.exists(),
                    "clearInProgress": runtime.clear_profile.is_set(),
                    "clearError": runtime.clear_error,
                },
            )
            return

        if path.startswith("/api/"):
            self._send_json(404, {"error": "Not found"})
            return

        relative = unquote(path.lstrip("/"))
        requested = (APP_ROOT / relative).resolve()
        try:
            requested.relative_to(APP_ROOT.resolve())
        except ValueError:
            self._send_json(404, {"error": "Not found"})
            return

        if requested.is_dir():
            requested = requested / "index.html"
        if not requested.is_file():
            requested = APP_ROOT / "index.html"
        if not requested.is_file():
            self._send_json(503, {"error": "Dashboard files are missing"})
            return

        content_type = "text/html; charset=utf-8"
        suffix_types = {
            ".css": "text/css; charset=utf-8",
            ".js": "text/javascript; charset=utf-8",
            ".json": "application/json; charset=utf-8",
            ".svg": "image/svg+xml",
            ".png": "image/png",
            ".webp": "image/webp",
            ".ico": "image/x-icon",
            ".woff": "font/woff",
            ".woff2": "font/woff2",
        }
        content_type = suffix_types.get(requested.suffix, content_type)
        body = requested.read_bytes()
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header(
            "Content-Security-Policy",
            "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; "
            "font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; "
            "object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https:",
        )
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Cache-Control", "no-cache" if requested.name == "index.html" else "public, max-age=31536000, immutable")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:
        if urlsplit(self.path).path != "/api/clear-login":
            self._send_json(404, {"error": "Not found"})
            return
        if self.headers.get("Host") != f"{HOST}:{PORT}":
            self._send_json(403, {"error": "Unexpected host"})
            return
        if self.headers.get("Origin") != ALLOWED_ORIGIN:
            self._send_json(403, {"error": "Request must come from the Streamline dashboard"})
            return
        if self.headers.get_content_type() != "application/json":
            self._send_json(415, {"error": "Expected JSON"})
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
            if length < 2:
                self._send_json(400, {"error": "Expected an empty JSON object"})
                return
            if length > 4096:
                self._send_json(413, {"error": "Request too large"})
                return
            payload = json.loads(self.rfile.read(length))
        except (ValueError, json.JSONDecodeError):
            self._send_json(400, {"error": "Invalid request"})
            return
        if payload != {}:
            self._send_json(400, {"error": "Expected an empty JSON object"})
            return

        with runtime.state_lock:
            if runtime.clear_profile.is_set():
                self._send_json(409, {"error": "A profile clear is already in progress"})
                return
            runtime.clear_error = None
            runtime.clear_profile.set()
        self._send_json(
            202,
            {
                "accepted": True,
                "message": "Firefox is restarting with a clean profile.",
            },
        )


def main() -> None:
    server = ThreadingHTTPServer((HOST, PORT), DashboardHandler)
    server.daemon_threads = True
    runtime.browser = threading.Thread(
        target=runtime.supervise_browser,
        name="streamline-firefox",
        daemon=True,
    )
    runtime.browser.start()
    try:
        server.serve_forever(poll_interval=0.25)
    except KeyboardInterrupt:
        pass
    finally:
        runtime.stop.set()
        runtime.clear_profile.set()
        server.shutdown()
        if runtime.browser is not None:
            runtime.browser.join(timeout=10)
        server.server_close()


if __name__ == "__main__":
    main()
